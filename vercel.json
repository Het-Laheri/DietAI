{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/scan-food",
      "destination": "/api/ai/scan-food"
    },
    {
      "source": "/api/ai/meal-plan",
      "destination": "/api/ai/meal-plan"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/queries/submit",
      "destination": "/api/queries/submit"
    },
    {
      "source": "/api/queries/reply",
      "destination": "/api/queries/reply"
    },
    {
      "source": "/api/queries/poll",
      "destination": "/api/queries/poll"
    },
    {
      "source": "/api/knowledge/list",
      "destination": "/api/knowledge/list"
    },
    {
      "source": "/api/knowledge/import",
      "destination": "/api/knowledge/import"
    },
    {
      "source": "/api/knowledge/clear",
      "destination": "/api/knowledge/clear"
    },
    {
      "source": "/api/create-order",
      "destination": "/api/payment/create-order"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/payment/verify-payment"
    },
    {
      "source": "/api/payment/create-order",
      "destination": "/api/payment/create-order"
    },
    {
      "source": "/api/payment/verify-payment",
      "destination": "/api/payment/verify-payment"
    },
    {
      "source": "/api/auth/change-password",
      "destination": "/api/auth/change-password"
    },
    {
      "source": "/api/notifications/vapid-key",
      "destination": "/api/queries/poll?notifAction=vapid-key"
    },
    {
      "source": "/api/notifications/subscribe",
      "destination": "/api/queries/poll?notifAction=subscribe"
    },
    {
      "source": "/api/notifications/reminders",
      "destination": "/api/queries/poll?notifAction=reminders"
    },
    {
      "source": "/api/notifications/process-reminders",
      "destination": "/api/queries/poll?notifAction=process-reminders"
    },
    {
      "source": "/api/notifications/test-push",
      "destination": "/api/queries/poll?notifAction=test-push"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/queries/poll?notifAction=process-reminders",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
