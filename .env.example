# Copy to .env (never commit .env). In production set these in Vercel → Settings → Environment Variables.
# Never prefix a secret with VITE_ — VITE_ variables are compiled into the public browser bundle.

# ── Server: Firebase Admin (required) ─────────────────────────────
# Service account JSON for the careclarity-e67bb project (Firebase console → Project settings →
# Service accounts → Generate new private key). Paste the whole JSON on one line,
# or use FIREBASE_SERVICE_ACCOUNT_BASE64 with the base64 of the file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional: named Firestore database (defaults to the app's database)
# FIRESTORE_DATABASE_ID=

# ── Server: CORS (optional) ───────────────────────────────────────
# Comma-separated browser origins allowed to call the API cross-origin.
# ALLOWED_ORIGINS=https://www.nutrisnap.co.in,https://nutrisnap.co.in

# ── Server: AI (required for AI features) ─────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional self-hosted OpenAI-compatible endpoint (dev server only)
# OPEN_WEBUI_URL=
# OPEN_WEBUI_API_KEY=
# OPEN_WEBUI_MODEL=

# ── Server: Razorpay (required for payments) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Server: rate limiting (optional, recommended) ─────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

APP_URL=
