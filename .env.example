# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPEN WEBUI / SELF-HOSTED LLM INTEGRATION:
# Set OPEN_WEBUI_URL to point to your Open WebUI API endpoint (e.g. http://localhost:8080/api/v1)
# OPEN_WEBUI_URL="http://localhost:8080/api/v1"
# OPEN_WEBUI_API_KEY="your_open_webui_api_key"
# OPEN_WEBUI_MODEL="llama3.3:latest"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ─── META WHATSAPP CLOUD API ────────────────────────────────
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=nutrisnap_whatsapp_token
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0

# ─── DIETICIAN LOGIN ────────────────────────────────────────
# VITE_DIETICIAN_EMAIL=admin@aidiet.com
# VITE_DIETICIAN_PASSWORD=Admin123!
