rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDietician() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dietician';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isDietician() || isOwner(userId);
      // Patients cannot create their own users, but we'll allow dietician to do it,
      // but creation via client sdk with their own uid is needed for the first time if using signup.
      // Wait, patient accounts are created by the dietician. The dietician can't use standard client SDK to create another user without being signed out, so they'll probably use Firebase Admin or just store the profile and send credentials.
      allow write: if isDietician() || isOwner(userId);
    }
    
    match /patient_profiles/{patientId} {
      allow read: if isDietician() || isOwner(patientId);
      allow write: if isDietician() || isOwner(patientId);
    }

    match /meal_plans/{planId} {
      allow read: if isDietician() || isOwner(resource.data.patientId);
      allow write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /food_logs/{logId} {
      allow read: if isDietician() || isOwner(resource.data.patientId);
      allow write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /progress_records/{recordId} {
      allow read: if isDietician() || isOwner(resource.data.patientId);
      allow write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /queries/{queryId} {
      allow read: if isDietician() || isOwner(resource.data.patientId);
      allow write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /dietician_notes/{noteId} {
      allow read, write: if isDietician();
    }
    
    match /ai_conversations/{convId} {
      allow read, write: if isDietician() || isOwner(resource.data.userId);
    }

    match /notifications/{notificationId} {
      allow read, write: if isDietician();
    }

    match /whatsapp_messages/{msgId} {
      allow read, write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /whatsapp_conversations/{convId} {
      allow read, write: if isDietician() || isOwner(resource.data.patientId);
    }

    match /recipes_db/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if isDietician();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
