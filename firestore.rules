rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDietician() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dietician';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /patient_profiles/{patientId} {
      allow read, write: if true;
    }

    match /meal_plans/{planId} {
      allow read, write: if true;
    }

    match /food_logs/{logId} {
      allow read, write: if true;
    }

    match /progress_records/{recordId} {
      allow read, write: if true;
    }

    match /queries/{queryId} {
      allow read, write: if true;
    }

    match /dietician_notes/{noteId} {
      allow read, write: if true;
    }
    
    match /ai_conversations/{convId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /ai_coach_messages/{msgId} {
      allow read, write: if true;
    }

    match /recipes_db/{recipeId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
