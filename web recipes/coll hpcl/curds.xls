<html><head><style>
BODY{MARGIN-TOP: 0px; MARGIN-LEFT: 0px; MARGIN-RIGHT: 0px; margin-botom: 0px }
.clTableHeader {BORDER-RIGHT: black 1px solid; BORDER-TOP: black 1px solid; FONT-SIZE: 16pt; BORDER-LEFT: black 1px solid; BORDER-BOTTOM: black 1px solid; FONT-FAMILY: arial; }
.clTableBody {	BORDER-RIGHT: black 1px solid; BORDER-TOP: black 1px solid; FONT-SIZE: 9pt; BORDER-LEFT: black 1px solid; BORDER-BOTTOM: black 1px solid; FONT-FAMILY: arial; }
.clReportBody {BORDER-RIGHT: black 1px solid; BORDER-TOP: black 1px solid; FONT-SIZE: 8pt; BORDER-LEFT: black 1px solid; BORDER-BOTTOM: black 1px solid; FONT-FAMILY: arial; }
</style></head><body>
<table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td align=middle class=clTableHeader colspan=8><b>Food Details</b></td></tr></table><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td class=clReportBody align=center><b>S.No.</b></td><td class=clReportBody align=left><b>Food Item Name</b></td><td class=clReportBody align=left><b>Food Code</b></td><td class=clReportBody align=left><b>Food Group</b></td><td class=clReportBody align=left><b>Measure Type</b></td><td class=clReportBody align=left><b>Measure Detail</b></td><td class=clReportBody align=left><b>Net Grams of Edible Portion</b></td></tr>
<tr><td class=clReportBody align=center>1.</td><td class=clReportBody align=left>Curds (cow's milk)</td><td class=clReportBody align=left>423</td><td class=clReportBody align=left>Milk and Milk Products</td><td class=clReportBody align=left>EDIBLE PORTION WEIGHT</td><td class=clReportBody align=left>Weight of Edible Portion = 67.0000 grams</td><td class=clReportBody align=left>67.0000 grams</td></tr>
</table>
<br><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td align=middle class=clTableHeader colspan=7><b>Nutritive Value Details</b></td></tr></table><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td class=clReportBody align=center><b>S.No.</b></td><td class=clReportBody align=left><b>Food Item</b></td><td class=clReportBody align=left><b>Measure Detail</b></td><td class=clReportBody align=left><b>Energy [Kcal]</b></td><td class=clReportBody align=left><b>Carbohydrates [gms]</b></td><td class=clReportBody align=left><b>Protein [gms]</b></td><td class=clReportBody align=left><b>Fat [gms]</b></td></tr>
<tr><td class=clReportBody align=center>1.</td><td class=clReportBody align=left>Curds (cow's milk) (423)</td><td class=clReportBody align=left>Weight of Edible Portion = 67.0000 grams</td><td class=clReportBody align=left>40.2000</td><td class=clReportBody align=left>2.0100</td><td class=clReportBody align=left>2.0770</td><td class=clReportBody align=left>2.6800</td></tr>
<tr><td class=clReportBody align=center></td><td class=clReportBody align=left>Total:</td><td class=clReportBody align=left></td><td class=clReportBody align=left>40.2000</td><td class=clReportBody align=left>2.0100</td><td class=clReportBody align=left>2.0770</td><td class=clReportBody align=left>2.6800</td></tr>
</table>
</body></html>