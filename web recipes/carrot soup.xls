<tr><td class=clReportBody align=center>1.</td><td class=clReportBody align=left>Carrot </td><td class=clReportBody align=left>118</td><td class=clReportBody align=left>Roots and Tubers</td><td class=clReportBody align=left>EDIBLE PORTION WEIGHT</td><td class=clReportBody align=left>Weight of Edible Portion = 7.0000 grams</td><td class=clReportBody align=left>7.0000 grams</td></tr>
<tr><td class=clReportBody align=center>2.</td><td class=clReportBody align=left>Maize,dry</td><td class=clReportBody align=left>5</td><td class=clReportBody align=left>Cereal grains and products</td><td class=clReportBody align=left>EDIBLE PORTION WEIGHT</td><td class=clReportBody align=left>Weight of Edible Portion = 2.0000 grams</td><td class=clReportBody align=left>2.0000 grams</td></tr>
</table>
<br><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td align=middle class=clTableHeader colspan=7><b>Nutritive Value Details</b></td></tr></table><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
<tr><td class=clReportBody align=center><b>S.No.</b></td><td class=clReportBody align=left><b>Food Item</b></td><td class=clReportBody align=left><b>Measure Detail</b></td><td class=clReportBody align=left><b>Energy [Kcal]</b></td><td class=clReportBody align=left><b>Carbohydrates [gms]</b></td><td class=clReportBody align=left><b>Protein [gms]</b></td><td class=clReportBody align=left><b>Fat [gms]</b></td></tr>
<tr><td class=clReportBody align=center>1.</td><td class=clReportBody align=left>Carrot  (118)</td><td class=clReportBody align=left>Weight of Edible Portion = 7.0000 grams</td><td class=clReportBody align=left>3.3600</td><td class=clReportBody align=left>0.7420</td><td class=clReportBody align=left>0.0630</td><td class=clReportBody align=left>0.0140</td></tr>
<tr><td class=clReportBody align=center>2.</td><td class=clReportBody align=left>Maize,dry (5)</td><td class=clReportBody align=left>Weight of Edible Portion = 2.0000 grams</td><td class=clReportBody align=left>6.8400</td><td class=clReportBody align=left>1.3240</td><td class=clReportBody align=left>0.2220</td><td class=clReportBody align=left>0.0720</td></tr>
<tr><td class=clReportBody align=center></td><td class=clReportBody align=left>Total:</td><td class=clReportBody align=left></td><td class=clReportBody align=left>10.2000</td><td class=clReportBody align=left>2.0660</td><td class=clReportBody align=left>0.2850</td><td class=clReportBody align=left>0.0860</td></tr>
</table>
</body></html>