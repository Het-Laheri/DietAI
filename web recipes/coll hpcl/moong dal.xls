<tr><td class=clReportBody align=center>1.</td><td class=clReportBody align=left>Green gram,dhal (35)</td><td class=clReportBody align=left>Weight of Edible Portion = 16.0000 grams</td><td class=clReportBody align=left>55.6800</td><td class=clReportBody align=left>9.5840</td><td class=clReportBody align=left>3.9200</td><td class=clReportBody align=left>0.1920</td></tr>
<tr><td class=clReportBody align=center>2.</td><td class=clReportBody align=left>Cooking oil (groundnut, gingelly, palmolein, mustard, coconut, etc) (438)</td><td class=clReportBody align=left>Weight of Edible Portion = 1.0000 grams</td><td class=clReportBody align=left>9.0000</td><td class=clReportBody align=left>0.0000</td><td class=clReportBody align=left>0.0000</td><td class=clReportBody align=left>1.0000</td></tr>
<tr><td class=clReportBody align=center></td><td class=clReportBody align=left>Total:</td><td class=clReportBody align=left></td><td class=clReportBody align=left>64.6800</td><td class=clReportBody align=left>9.5840</td><td class=clReportBody align=left>3.9200</td><td class=clReportBody align=left>1.1920</td></tr>
</table>
</body></html>