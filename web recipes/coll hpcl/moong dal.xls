<tr><td class=clReportBody align=center>2.</td><td class=clReportBody align=left>Cooking oil (groundnut, gingelly, palmolein, mustard, coconut, etc)</td><td class=clReportBody align=left>438</td><td class=clReportBody align=left>Fats and Edible Oils</td><td class=clReportBody align=left>EDIBLE PORTION WEIGHT</td><td class=clReportBody align=left>Weight of Edible Portion = 1.0000 grams</td><td class=clReportBody align=left>1.0000 grams</td></tr>
</table>
<br><table cellpadding=3 cellspacing=0 width=100% align=center style='border-collapse:collapse;'>
